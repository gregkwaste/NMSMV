<UserControl x:Class="WPFModelViewer.ModelTransform"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFModelViewer"
             mc:Ignorable="d">
    <!-- Edits apply with Enter (HandleKeyUpEvent) or the Apply button. The label column lines up with the Object Info rows -->
    <StackPanel>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="PropLabel"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="X" HorizontalAlignment="Center" Style="{StaticResource AxisLabel}"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" HorizontalAlignment="Center" Style="{StaticResource AxisLabel}"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Z" HorizontalAlignment="Center" Style="{StaticResource AxisLabel}"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Translation" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="translationX" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="1" Grid.Column="2" x:Name="translationY" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="translationZ" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rotation" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="rotationX" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="2" Grid.Column="2" x:Name="rotationY" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="2" Grid.Column="3" x:Name="rotationZ" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Scale" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="scaleX" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="3" Grid.Column="2" x:Name="scaleY" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="3" Grid.Column="3" x:Name="scaleZ" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="AABB Min" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" ToolTip="Bounding box"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AABBMINX" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="4" Grid.Column="2" x:Name="AABBMINY" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="4" Grid.Column="3" x:Name="AABBMINZ" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBlock Grid.Row="5" Grid.Column="0" Text="AABB Max" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" ToolTip="Bounding box"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="AABBMAXX" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="5" Grid.Column="2" x:Name="AABBMAXY" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
        <TextBox Grid.Row="5" Grid.Column="3" x:Name="AABBMAXZ" Style="{StaticResource NumberBox}" Margin="1" PreviewTextInput="FilterTextInput" KeyUp="HandleKeyUpEvent" MaxLines="1" MinLines="1" Text="0" IsUndoEnabled="True"/>
    </Grid>

    <UniformGrid Columns="2" Margin="0,4,0,0">
        <Button Margin="0,0,2,0" Click="applyTransformButtonTrigger">Apply</Button>
        <Button Margin="2,0,0,0" Click="resetTransform">Reset</Button>
    </UniformGrid>
    <DockPanel Margin="0,4,0,0">
        <TextBlock DockPanel.Dock="Left" Text="Export node" Margin="0,0,10,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <UniformGrid Columns="2">
            <Button Margin="0,0,2,0" Click="exportToMXML">MXML</Button>
            <Button Margin="2,0,0,0" Click="exportToMBIN">MBIN</Button>
        </UniformGrid>
    </DockPanel>
    </StackPanel>
</UserControl>
